ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-haiku-4-5-20251001
HF_TOKEN=hf_...   # optional — suppresses HuggingFace anonymous-download warning

# --- UI/demo dev loop: replay a cached debate instead of calling the model ---
MOCK_LLM=false            # set true to exercise the UI/failover demo for free —
                          # replays tests/deepeval_promptfoo/.debate_cache/*.json
                          # (matched by topic, falling back to any cached one)
                          # instead of calling Anthropic. Unset/false before
                          # running for real.
MOCK_LLM_DELAY_SECONDS=1.5  # per-node artificial delay, so streaming/pills still look real

# --- Durable graph state (Postgres checkpointer) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debate_bot

# --- Streaming relay (Redis pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Run ownership + heartbeat (automatic failover) ---
NODE_ID=node-a   # unique per node/container; defaults to a random local id if unset

# --- Evaluation (LLM-as-judge, shared by Approach A & B) ---
JUDGE_MODEL_NAME=claude-sonnet-5   # stronger model grades debates; never grades itself
EVAL_CACHE_DEBATES=true            # cache each topic's debate transcript locally
                                    # (tests/deepeval_promptfoo/.debate_cache/) so
                                    # reruns only pay for judge scoring; set false
                                    # to force a live debate every run

# --- Approach B: hosted LangSmith evaluation (tests/lang_smith/) ---
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true          # auto-traces each LangGraph node to LangSmith
LANGCHAIN_PROJECT=debate-bot-evals # optional — groups runs in the LangSmith UI
